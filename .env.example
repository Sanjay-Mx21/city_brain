# docker-compose settings. Copy to .env and fill in.
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_PASSWORD=
JWT_SECRET=
SECRET_KEY=

# Public URL users open in the browser (for CORS)
FRONTEND_URL=http://localhost:8080
HTTP_PORT=8080

# Passwords for the admin/officer accounts created by scripts/seed_data.py
SEED_ADMIN_PASSWORD=
SEED_OFFICER_PASSWORD=
# true = also create demo citizens + synthetic complaints
SEED_DEMO_DATA=false

# Optional: Ollama LLM (falls back to the rule-based parser if unreachable)
OPEN_SOURCE_LLM_URL=http://host.docker.internal:11434/api/generate
OPEN_SOURCE_LLM_MODEL=mistral

ENABLE_API_DOCS=false
