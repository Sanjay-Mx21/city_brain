# ─── City Brain backend configuration ───
# Copy to .env and fill in. In production (APP_ENV=production) the app refuses
# to start unless JWT_SECRET / SECRET_KEY are 32+ random chars and DEBUG=false.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — SQLite for local dev, PostgreSQL for production.
# postgres:// and postgresql:// URLs are converted to asyncpg automatically.
DATABASE_URL=sqlite+aiosqlite:///./citybrain.db
DATABASE_URL_SYNC=sqlite:///./citybrain.db
# DATABASE_URL=postgresql+asyncpg://citybrain:password@localhost:5432/citybrain

# Public URL of the frontend (used for CORS). Add more origins comma-separated.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

# Hide /docs and /redoc in production if you prefer
ENABLE_API_DOCS=true

# Uploads
UPLOAD_DIR=uploads
MAX_IMAGE_UPLOAD_MB=10
MAX_AUDIO_UPLOAD_MB=25

# Local LLM (Ollama). If unreachable, the rule-based parser is used automatically.
OPEN_SOURCE_LLM_URL=http://localhost:11434/api/generate
OPEN_SOURCE_LLM_MODEL=mistral
TRAINED_LLM_MODEL=citybrain-mistral

# Voice transcription (faster-whisper)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Bhashini translation (optional)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# WhatsApp / Twilio — disabled for now
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
